{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "redirects": [
        {
          "source": "/residential",
          "destination": "/projects#residential",
          "permanent": false
        },
        {
          "source": "/commercial",
          "destination": "/projects#commercial",
          "permanent": false
        }
      ],
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(assets|projects|tex)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
